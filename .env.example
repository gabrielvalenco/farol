# Farol, variaveis de ambiente
# Copie para .env.local e preencha. Tudo e opcional pra rodar localmente,
# mas em producao PSI_API_KEY e DATABASE_URL sao necessarias.

# URL publica do site (imagem de OG). Opcional na Vercel: sem ela, usa o dominio de producao.
NEXT_PUBLIC_SITE_URL=

# PageSpeed Insights API (Google Cloud > APIs e servicos > Credenciais)
# Sem chave, usa a cota anonima, que costuma estar esgotada.
PSI_API_KEY=

# Postgres (Neon ou Supabase). Sem isso, localmente os relatorios ficam em .data/
# Use a connection string "pooled" / "transaction" do provedor.
DATABASE_URL=

# Upstash Redis: limite de analises por pessoa e cache de URL.
# Sem isso, fica em memoria (vale so por instancia).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rodape de conversao do relatorio. Sem numero, o bloco nao aparece.
# So digitos, com DDI: 5518999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Limites (padrao da spec: 5 analises a cada 10 minutos, cache de 10 minutos)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10
CACHE_MINUTES=10

# Corte da analise em segundos (maximo 50). Sites que a PageSpeed demora mais que isso recebem mensagem de tempo esgotado.
ANALYSIS_TIMEOUT_SECONDS=45

# So para testes: aponta a PSI para um servidor falso
# PSI_API_URL=http://127.0.0.1:4010/runPagespeed
